AGENT_API_BASE_URL=https://showmevibecode.up.railway.app/api/model/v1
AGENT_API_KEY=replace-with-your-key
# Run npm run check:models to discover models, then choose a tool-capable one.
AGENT_MODEL=
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_MS=600000
AGENT_REASONING_EFFORT=low
# Optional absolute CLI executable; default: opencode
# AGENT_CLI=/path/to/opencode
